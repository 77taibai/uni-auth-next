{
  "name": "uni-auth",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "uqr": "^0.1.3",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}



