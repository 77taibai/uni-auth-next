# 运行时基础设施配置（身份资料与密码存于数据库，见 /setup 首次初始化）
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 站点对外源，必须显式配置；不要依赖 Host 头拼接 issuer
PUBLIC_ORIGIN=http://localhost:3000

# 32 字节 base64，用于加密 TOTP 密钥；丢失即无法解密既有 TOTP 凭证
MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64

# 密码哈希迭代次数（/setup 与改密时使用）
PBKDF2_ITERATIONS=100000

NODE_ENV=development

# 可选：数据库 TLS。连接串带 sslmode=require 时自动启用
# DATABASE_SSL=require
